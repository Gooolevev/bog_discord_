# Публичный адрес сайта. Для локального npm run dev используй один и тот же host в браузере и здесь.
SITE_URL=http://127.0.0.1:3000
# Application ID уже существующего Discord-бота; нужен также для ссылки приглашения.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Независимый случайный секрет не короче 32 символов. Не используй токен Discord.
SESSION_SECRET=
# Закрытый API Python на этом же компьютере. BOT_API_SECRET должен совпадать с .env бота.
BOT_API_URL=http://127.0.0.1:8081
BOT_API_SECRET=
# Необязательно: начальная ссылка на Spotify-трек, альбом или плейлист.
# Можно оставить пустым — посетитель сможет вставить свою ссылку.
SPOTIFY_URL=
