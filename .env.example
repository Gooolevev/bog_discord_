# Скопируй в .env и заполни локально. Реальные секреты не коммить.
DISCORD_TOKEN=
MC_SERVER=
# 0 — мониторинг выключен; иначе ID текстового канала Discord.
MONITOR_CHANNEL=0
# Ключ: https://enter.pollinations.ai ; запросы используют бюджет аккаунта.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
# Необязательно: HTTP-проверка готовности для хостинга, например PORT=8080.
# PORT=8080

# Необязательно: закрытый API панели сайта; слушает только 127.0.0.1.
# Без BOT_API_PORT API выключен. Отдельный случайный секрет от 32 символов.
# Такой же BOT_API_SECRET нужно указать в website/.env.local.
BOT_API_PORT=
BOT_API_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
